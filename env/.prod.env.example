# env/.prod.env — PROD environment (loaded when QA_TARGET_ENV=prod).
# Copy to `env/.prod.env` and fill in the Restricted values. NEVER commit the real file.
# On CI the prod pipeline materializes this file from the DOTENV_PROD repo secret.

QA_TARGET_ENV=prod
PRODUCT_E2E_ENABLED=true

# Prod (energy.organuz.com) has NO password gate — per-role login creds only.
# Names are UNPREFIXED here — the file itself scopes them to prod.
CUSTOMER_PHONE=
CUSTOMER_OTP_CODE=

# SMS-OTP login (Twilio). Prod delivers a LIVE code by SMS (no fixed 7777), so the
# cellular-login-sms spec reads it from Twilio. Opt-in — off unless PRODUCT_SMS_LOGIN=true.
PRODUCT_SMS_LOGIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: the Twilio number that RECEIVES the code, if it differs from CUSTOMER_PHONE.
TWILIO_OTP_NUMBER=

# Shared alerting webhooks (optional; any/all). Absent => that Slack post is skipped.
# run-all-tests.sh posts the run status + Allure / Grafana / Playwright HTML / Scalar
# report links to every webhook that is set.
SLACK_WEBHOOK_URL=
SLACK_WEBHOOK_BOT_URL=
SLACK_ORGANUZ_TESTING_URL=

# GitHub repo home (used for report/remote links).
REMOTE_HREF=https://github.com/amiel-organuz/OrGanuzAiSiteTestAutomation/
