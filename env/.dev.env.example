# env/.dev.env — DEV environment (loaded when QA_TARGET_ENV=dev, the default).
# Copy to `env/.dev.env` and fill in the Restricted values. NEVER commit the real file.
# Loaded by playwright.config.ts and scripts/run-all-tests.sh based on QA_TARGET_ENV.

QA_TARGET_ENV=dev
PRODUCT_E2E_ENABLED=true

# Dev/Test product app sits behind a shared password gate (single סיסמה field).
PRODUCT_PLATFORM_PASSWORD=

# Optional explicit URL overrides (otherwise resolved from config.json by QA_TARGET_ENV).
APP_BASE_URL=
APP_ADMIN_URL=

# Per-role login credentials. Dev uses the fixed OTP 7777 (not a live SMS).
# Names are UNPREFIXED here — the file itself scopes them to dev.
CUSTOMER_PHONE=0510000000
CUSTOMER_OTP_CODE=7777
CONSULTANT_PHONE=0569875332
CONSULTANT_OTP_CODE=7777
COMPANY_PHONE=0531415667
COMPANY_OTP_CODE=7777

# Shared alerting webhooks (optional; any/all). Absent => that Slack post is skipped.
# run-all-tests.sh posts the run status + Allure / Grafana / Playwright HTML / Scalar
# report links to every webhook that is set.
SLACK_ORGANUZ_TESTING_URL=

# GitHub repo home (used for report/remote links).
REMOTE_HREF=https://github.com/amiel-organuz/OrGanuzAiSiteTestAutomation/
