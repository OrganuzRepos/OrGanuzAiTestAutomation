{
  "name": "organuz-ai-site-test-automation",
  "version": "1.0.0",
  "description": "Playwright TypeScript E2E automation for www.organuz.ai",
  "scripts": {
    "test": "NODE_OPTIONS=--disable-warning=DEP0205 playwright test",
    "test:headed": "NODE_OPTIONS=--disable-warning=DEP0205 playwright test --headed --workers=1",
    "test:parallel": "NODE_OPTIONS=--disable-warning=DEP0205 playwright test --workers=4",
    "test:ui": "NODE_OPTIONS=--disable-warning=DEP0205 playwright test --project=local-web",
    "test:product": "NODE_OPTIONS=--disable-warning=DEP0205 playwright test --project=product",
    "test:monitoring": "MONITORING_ENABLED=true NODE_OPTIONS=--disable-warning=DEP0205 playwright test --project=monitoring",
    "test:all": "./scripts/run-all-tests.sh",
    "test:all:dev": "./scripts/run-all-tests.sh dev",
    "test:all:prod": "./scripts/run-all-tests.sh prod",
    "slack:test": "./scripts/slack-alert-test.sh",
    "report": "playwright show-report playwright-report",
    "clean:results": "rm -rf allure-results allure-report blob-report test-results playwright-report",
    "report:allure:fresh": "npm run clean:results && playwright test && npm run report:allure",
    "report:allure": "{ test -d allure-report/history && cp -r allure-report/history allure-results/; } 2>/dev/null || true && npx allure generate allure-results -o allure-report --clean && npx allure open allure-report",
    "report:allure:ci": "npx allure generate allure-results -o allure-report --clean",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "agent:build": "tsc -p tsconfig.json",
    "agent:demo": "npm run agent:build && node dist/src/agent/demo/run-demo.js",
    "agent:plan": "npm run agent:build && node dist/src/agent/demo/generate-test-plan.js",
    "test-plans:pdf": "npm run agent:build && node dist/src/tools/build-test-plan-pdfs.js",
    "agent:current-tests": "npm run agent:build && node dist/src/agent/run-current-tests.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/mcp": "^0.0.78",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "allure-commandline": "^2.42.0",
    "allure-js-commons": "^3.9.0",
    "allure-playwright": "^3.9.0",
    "dotenv": "^16.4.5",
    "eslint": "^10.4.1",
    "json-server": "^0.17.4",
    "mammoth": "^1.12.0",
    "marked": "^4.3.0",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.63.0",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  }
}
