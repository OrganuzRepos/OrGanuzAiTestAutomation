# NOTE: credentials are now split per target env under env/ — see env/.dev.env.example
# and env/.prod.env.example (loaded by QA_TARGET_ENV). This root .env is an OPTIONAL
# shared fallback and a full reference of every supported var. Prefer env/.<target>.env
# for the per-role phone/OTP creds and the dev password gate.
#
# Which Organuz environment the product/app tests target: dev | test | prod.
# Defaults to "dev" (config.json defaultEnv). The app + admin URLs are resolved
# from config.json -> environments. Set QA_TARGET_ENV=prod for the prod app.
QA_TARGET_ENV=dev

# Base URL for the Organuz marketing site (stays on the prod marketing host).
# WEB_BASE_URL=https://www.organuz.ai

# Explicit overrides for the product app + admin console. Leave unset to inherit
# from QA_TARGET_ENV. Dev app = https://dev1.app.organize.organuz.com
# APP_BASE_URL=https://dev1.app.organize.organuz.com
# APP_ADMIN_URL=https://organuz.flamiingo.com

# Organuz backend API (Supabase). Anon key + URL default from config.json; override if needed.
# ORGANUZ_API_BASE_URL=https://yrvgdswzbinmdyzxzblp.supabase.co

# Playwright settings
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
WORKERS=4
BROWSER=chromium
INCLUDE_LOW_PRIORITY_TESTS=false

# --- Product E2E matrix ---
# Disabled by default until real app selectors and persona credentials are available.
PRODUCT_E2E_ENABLED=false
# Explicitly opt in to side-effecting/diagnostic product checks.
PRODUCT_OTP_UI=false
PRODUCT_WIZARD_E2E=false
PRODUCT_LOGIN_PATH=/
PRODUCT_COMPANY_PRICING_PATH=/company/pricing
PRODUCT_COMPANY_MANAGEMENT_PATH=/company/management
# Phone/OTP is the current live-app login path. Email/password remains supported
# by the test helper as a fallback if that path becomes available.
# DEV persona phones live in your local (gitignored) .env — sourced from the
# Restricted "Organuz Environments" doc. OTP codes are dynamic (per login).
CUSTOMER_PHONE=
CUSTOMER_OTP_CODE=
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
CONSULTANT_PHONE=
CONSULTANT_OTP_CODE=
CONSULTANT_EMAIL=
CONSULTANT_PASSWORD=
COMPANY_PHONE=
COMPANY_OTP_CODE=
COMPANY_EMAIL=
COMPANY_PASSWORD=
COMPANY_EMPLOYEE_PHONE=
COMPANY_EMPLOYEE_OTP_CODE=
COMPANY_EMPLOYEE_EMAIL=
COMPANY_EMPLOYEE_PASSWORD=

# --- Product fraud / account-takeover checks ---
# Optional overrides; defaults resolve from QA_TARGET_ENV/config.json.
# FRAUD_AUTH_BACKEND=https://organuz.flamiingo.com
# FRAUD_APP_TOKEN=
# FRAUD_OTP_VERIFY_CALL=

# --- QA MCP agent (src/agent) ---
# Azure DevOps target + blast-radius scoping
ADO_PLAN_ID=PLAN-1
ADO_SUITE_ID=SUITE-1
ADO_START_READONLY=true
# Run behaviour
QA_ENVIRONMENT=staging
QA_RERUN_FLAKY=true
QA_FLAKY_TAG=@flaky
QA_FILE_BUGS=true
QA_MAX_CASES=0
# Evidence (OneDrive) folder prefix
QA_EVIDENCE_PREFIX=qa-runs
# Requirements-document enrichment (optional). Empty path disables it.
# QA_REQUIREMENTS_PATH=test-requirements-docs
QA_REQUIREMENTS_SOURCE=local

# scripts/push-qa-metrics.mjs reads the latest Playwright JSON report from this
# path and PUSHES it as qa_playwright_* metrics to the Prometheus Pushgateway
# (PUSHGATEWAY_URL) for the Grafana QA dashboard.
QA_PLAYWRIGHT_RESULTS_PATH=test-results/results.json
PUSHGATEWAY_URL=http://localhost:9091

# --- External-dependency monitoring (opt-in) ---
# Registers the `monitoring` Playwright project (tests/monitoring/** — Govmap +
# Ofek availability, 25 checks each). Off by default so the green PR gate never
# runs live third-party checks. `npm run test:monitoring` sets this for you.
MONITORING_ENABLED=false

# Every monitoring endpoint value falls back to config.json → monitoring; set any
# of these to override without editing committed config. Use them to point tests
# at your OWN Govmap token/domain (a token you obtain from Govmap is bound to the
# domain it was issued for) or to track a yearly Ofek layer rename.
# GOVMAP_API_URL=https://www.govmap.gov.il
# GOVMAP_EMBED_TOKEN=<your-domain-bound-govmap-token>   # public embed token; not a hard secret, but keep your own out of git
# GOVMAP_EMBED_HOST=https://<the-origin-your-token-is-bound-to>/
# OFEK_TILES_URL=https://basemaps.govmap.gov.il
# OFEK_ORTHO_LAYER=orto2025me_update
# OFEK_LABELS_LAYER=labels_and_line_12_2025
# OFEK_REFERER=https://www.govmap.gov.il/
# MONITORING_LATENCY_MS=6000

# --- Slack alerting (optional; any/all) ---
# run-all-tests.sh posts the run status + Allure / Grafana / Playwright HTML / Scalar
# report links to every webhook set here after a run, and monitoring.yml pings on a
# Govmap/Ofek outage. Webhook URLs are SECRETS — set them in your real .env (or as
# GitHub repo secrets of the same names), never commit them.
# Smoke-test the wiring with ./scripts/slack-alert-test.sh.
# SLACK_WEBHOOK_URL=
# SLACK_WEBHOOK_BOT_URL=
# SLACK_ORGANUZ_TESTING_URL=      # the #organuz-testing channel
#
# GitHub repo home (used for report/remote links).
# REMOTE_HREF=https://github.com/amiel-organuz/OrGanuzAiSiteTestAutomation/

# `npm run agent:current-tests` uses the real Playwright CLI and respects the
# normal WEB_BASE_URL/APP_BASE_URL/API_BASE_URL variables above while keeping ADO/Sheets/
# OneDrive stubbed locally.

# --- GitHub Actions dispatch (optional) ---
# After a run, the orchestrator can dispatch a GitHub Actions workflow
# (the "Parallel Test Automation" pipeline). Disabled unless a token is present
# AND GITHUB_TRIGGER_WORKFLOW is enabled.
# GITHUB_TOKEN is a SECRET — set it in your real .env, never commit it.
# Needs a PAT with `actions: write` (fine-grained) or the `workflow` scope (classic).
# GITHUB_TOKEN=
GITHUB_TRIGGER_WORKFLOW=false
GITHUB_OWNER=amiel-organuz
GITHUB_REPO=OrGanuzAiSiteTestAutomation
GITHUB_WORKFLOW_FILE=parallel-tests.yml
GITHUB_WORKFLOW_REF=main
